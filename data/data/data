import numpy as np
import pandas as pd

# 数据加载（假设是CSV文件）
data = pd.read_csv('your_data.csv', header=None)  # 无表头数据
numpy_array = data.values  # 转换为(4000, 31)的numpy数组

# ================= 均值计算 =================
# 方法1：沿列方向计算（axis=0）
means = np.mean(numpy_array, axis=0)


# ============== 协方差矩阵计算 ===============
# 重要参数说明：
# rowvar=False 表示每列代表一个变量（默认True是行作为变量）
# bias=False 表示计算样本协方差（除以n-1），True为总体协方差（除以n）
cov_matrix = np.cov(numpy_array, rowvar=False, bias=False)

# ================ 结果验证 ================
print("均值向量形状:", means.shape)  # 应为(31,)
print("协方差矩阵形状:", cov_matrix.shape)  # 应为(31,31)

# 可选：转换为DataFrame更直观查看
df_means = pd.DataFrame(means.reshape(1, -1),
                       columns=[f'Col_{i}' for i in range(31)],
                       index=['Mean'])
df_cov = pd.DataFrame(cov_matrix,
                     columns=[f'Col_{i}' for i in range(31)],
                     index=[f'Col_{i}' for i in range(31)])

print("\n均值向量：")
print(df_means)
print("\n协方差矩阵前5x5部分：")
print(df_cov.iloc[:5,:5])